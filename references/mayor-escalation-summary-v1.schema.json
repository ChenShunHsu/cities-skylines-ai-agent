{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChenShunHsu/cities-skylines-ai-agent/references/mayor-escalation-summary-v1.schema.json",
  "title": "Mayor local executor escalation summary v1",
  "type": "object",
  "required": [
    "summaryVersion",
    "missionId",
    "instanceId",
    "toolContractVersion",
    "status",
    "executorSteps",
    "blockerCode",
    "before",
    "after",
    "attemptedCandidateIds",
    "evidenceRefs",
    "decisionNeeded"
  ],
  "properties": {
    "summaryVersion": {"type": "integer", "const": 1},
    "missionId": {"type": "string", "minLength": 1, "maxLength": 128},
    "instanceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "toolContractVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"type": "string", "const": "blocked"},
    "executorSteps": {"type": "integer", "minimum": 0, "maximum": 100},
    "blockerCode": {
      "type": "string",
      "enum": [
        "contract_scope_mismatch",
        "missing_required_telemetry",
        "two_no_progress_cycles",
        "mutation_requires_new_authority",
        "regression_or_recovery_required",
        "no_safe_candidate",
        "expired_contract",
        "tool_not_allowed",
        "step_budget_exhausted",
        "cost_budget_exhausted",
        "runtime_resource_limit",
        "malformed_model_output"
      ]
    },
    "before": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["metric", "value"],
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "population",
              "cashDisplay",
              "periodNetDisplay",
              "trafficFlow",
              "severeRoadCount",
              "problemBuildingCount",
              "unservedElectricityCount",
              "unservedWaterCount",
              "unservedSewageCount",
              "vacantDevelopmentCells",
              "serviceCoverageRatio"
            ]
          },
          "value": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "after": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["metric", "value"],
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "population",
              "cashDisplay",
              "periodNetDisplay",
              "trafficFlow",
              "severeRoadCount",
              "problemBuildingCount",
              "unservedElectricityCount",
              "unservedWaterCount",
              "unservedSewageCount",
              "vacantDevelopmentCells",
              "serviceCoverageRatio"
            ]
          },
          "value": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "attemptedCandidateIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 12, "maxLength": 512}
    },
    "decisionNeeded": {
      "type": "string",
      "enum": ["approve_replan_or_defer", "grant_new_authority_or_defer", "repair_telemetry", "run_recovery", "reduce_runtime_load", "revise_contract"]
    }
  },
  "additionalProperties": false
}
